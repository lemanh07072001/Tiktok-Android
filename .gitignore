# --- getseed_wire: LIVE credential-bearing captures — NEVER COMMIT ---
# pcaps contain decryptable QUIC traffic; keylogs contain TLS traffic secrets;
# together they expose real session credentials. Regenerable from a live phone.
ground-truth/getseed_wire/*.pcap
ground-truth/getseed_wire/*.pcapng
ground-truth/getseed_wire/*.sslog
ground-truth/getseed_wire/keylog*.txt
ground-truth/getseed_wire/*.key
ground-truth/getseed_wire/decoded/

# --- metasec secrets captured from live phone — NEVER COMMIT (feed via env, values git-ignored) ---
# device_secret plaintext + mus4573 license blob live here; regenerable from a live phone
cap.noindex/
**/cap.noindex/

# signer SM3-capture + report dumps (contain slot16/device query / device_token/dyn_seed)
signer/sm3cap.log
signer/rpt*.bin

