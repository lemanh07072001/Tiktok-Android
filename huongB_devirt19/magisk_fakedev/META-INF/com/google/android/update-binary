#!/sbin/sh
umask 022
OUTFD=$2; ZIPFILE=$3
mkdir -p /dev/tmp
unzip -o "$ZIPFILE" 'META-INF/com/google/android/*' -d /dev/tmp >/dev/null 2>&1
. /dev/tmp/META-INF/com/google/android/util_functions.sh 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
install_module
exit 0
